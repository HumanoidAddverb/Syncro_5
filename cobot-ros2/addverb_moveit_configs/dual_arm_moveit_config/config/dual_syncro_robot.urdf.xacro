<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dual_syncro_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import dual_syncro_robot urdf file -->
    <xacro:include filename="$(find addverb_cobot_description)/urdf/dual_arm_syncro/dual_arm.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="dual_syncro_robot.ros2_control.xacro" />


    <xacro:dual_syncro_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
