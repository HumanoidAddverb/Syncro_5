        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://addverb_cobot_description/syncro_meshes/gripper/left_link_1.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="gripper_finger_joint"
