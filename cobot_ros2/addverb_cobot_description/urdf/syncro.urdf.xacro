    <parent
      link="Link_3" />
    <child
      link="Link_4" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3"
      upper="3"
      effort="100"
      velocity="3" />
  </joint>
  <link
    name="Link_5">
    <inertial>
      <origin
        xyz="0.00006919 0.04683316 0.05879397"
        rpy="0 0 0" />
      <mass
        value="1.75457385" />
      <inertia
        ixx="0.00234701"
        ixy="-0.00000354"
        ixz="0.00000119"
        iyy="0.00172306"
        iyz="-0.00012186"
        izz="0.00229195" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://addverb_cobot_description/syncro_meshes/Link_5.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.941176470588235 0.925490196078431 0.882352941176471 1" />
      </material>
    </visual>
    <collision>
      <origin
