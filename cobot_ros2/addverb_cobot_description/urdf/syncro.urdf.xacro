        iyy="0.00979751"
        iyz="-0.00327398"
        izz="0.02120896" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://addverb_cobot_description/syncro_meshes/Link_3.STL" />
      </geometry>
