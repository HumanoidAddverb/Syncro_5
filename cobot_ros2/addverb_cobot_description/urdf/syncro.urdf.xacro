<!-- ############################################## FT ########################################## -->

  <xacro:if value="${has_ft}">
    <link
      name="FT_sensor">
      <inertial>
        <origin
          xyz="-0.000606383270312297 -0.000803593977746264 0.0265476058555786"
          rpy="0 0 0" />
        <mass
          value="0.25823184" />
        <inertia
          ixx="0.00019337"
          ixy="0.00000561"
          ixz="0.00000031"
          iyy="0.00018953"
          iyz="0.00000045"
          izz="0.00023996" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://addverb_cobot_description/syncro_meshes/ft/FT_sensor.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.898039215686275 0.917647058823529 0.929411764705882 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://addverb_cobot_description/syncro_meshes/ft/FT_sensor.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="FT_sensor"
      type="fixed">
      <origin
        xyz="0 0 ${ft_z}"
        rpy="0 0 0" />
      <parent
        link="Link_6" />
      <child
        link="FT_sensor" />
      <axis
        xyz="0 0 0" />
    </joint>
  </xacro:if>


<!-- #################################### GRIPPER #################################################-->

  <xacro:if value="${has_gripper}">
    <link
      name="gripper_base_link">
      <inertial>
        <origin
          xyz="0.000968305489002494 0.0272628721297719 -3.92206156679312E-05"
          rpy="0 0 0" />
        <mass
          value="0.667983718664473" />
        <inertia
          ixx="0.000378863528913665"
          ixy="3.04724981372968E-05"
          ixz="-2.24506309945257E-08"
          iyy="0.000437706032708141"
          iyz="-2.64895816315703E-07"
          izz="0.000492387437033956" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://addverb_cobot_description/syncro_meshes/gripper/gripper_base_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://addverb_cobot_description/syncro_meshes/gripper/gripper_base_link.STL" />
        </geometry>
      </collision>
    </link>

    <!-- When FT is present: attach gripper to FT_sensor at its designed offset -->
    <xacro:if value="${has_ft}">
      <joint
        name="gripper_base_joint"
        type="fixed">
        <origin
          xyz="0.00021987 -2.3546E-10 -0.006"
          rpy="0 0.0 3.1416" />
        <parent
          link="FT_sensor" />
        <child
          link="gripper_base_link" />
      </joint>
    </xacro:if>

    <!-- When FT is absent: attach gripper directly to Link_6 at combined offset (FT + gripper) -->
    <xacro:unless value="${has_ft}">
      <joint
        name="gripper_base_joint"
        type="fixed">
        <origin
          xyz="0.00021987 -2.3546E-10 ${-0.006 + ft_z}"
          rpy="0 0.0 0" />
        <parent
          link="Link_6" />
        <child
          link="gripper_base_link" />
      </joint>
    </xacro:unless>

    <link
      name="left_link_1">
      <inertial>
        <origin
          xyz="0.0155328722190179 0.0204027470076035 -6.99601561565458E-06"
          rpy="0 0 0" />
        <mass
          value="0.0512537568596193" />
        <inertia
          ixx="1.29730117984788E-05"
          ixy="2.28895824162255E-07"
          ixz="-1.62906963269812E-10"
          iyy="8.11595639482511E-06"
          iyz="-1.60558480946145E-09"
