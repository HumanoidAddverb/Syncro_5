        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://addverb_cobot_description/syncro_meshes/Link_5.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="Joint_5"
    type="revolute">
    <origin
      xyz="0.030953 0 0.1626"
      rpy="0 -0.5236 0" />
    <parent
      link="Link_4" />
    <child
      link="Link_5" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3"
      upper="3"
      effort="100"
      velocity="3" />
