        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://addverb_cobot_description/syncro_meshes/gripper/left_link_3.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="left_link_3_joint"
      type="revolute">
      <origin
