<?xml version="1.0" encoding="utf-8"?>
<robot
  name="robot"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Load payload configuration -->
  <xacro:property name="payload_cfg" value="${xacro.load_yaml('$(find addverb_cobot_control)/config/payload_config.yaml')}"/>
  <xacro:property name="has_ft"      value="${payload_cfg['ft_type'] != 0}"/>
  <xacro:property name="has_gripper" value="${payload_cfg['gripper_type'] != 0}"/>

  <!-- FT sensor offset from Link_6 (used to compute combined offset when FT absent) -->
  <xacro:property name="ft_z" value="0.0265"/>

  <link
    name="base_link">
    <inertial>
      <origin
        xyz="0.00003171 -0.00000834 0.00865705"
        rpy="0 0 0" />
      <mass
        value="3.71924208" />
      <inertia
        ixx="0.01620278"
        ixy="-0.00000270"
        ixz="0.00000057"
        iyy="0.01619715"
        iyz="-0.00000230"
        izz="0.02243728" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://addverb_cobot_description/syncro_meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.941176470588235 0.925490196078431 0.882352941176471 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://addverb_cobot_description/syncro_meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link
    name="Link_1">
    <inertial>
      <origin
        xyz="0.01250171 0.00005091 0.12286014"
        rpy="0 0 0" />
      <mass
        value="7.90090680" />
      <inertia
        ixx="0.04470291"
        ixy="-0.00000635"
        ixz="-0.00633054"
        iyy="0.04720102"
        iyz="0.00000610"
        izz="0.01586864" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://addverb_cobot_description/syncro_meshes/Link_1.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.941176470588235 0.925490196078431 0.882352941176471 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
