  <link
    name="Link_6">
    <inertial>
      <origin
        xyz="0.00110042 0.00023470 0.00814235"
        rpy="0 0 0" />
      <mass
        value="0.17834911" />
      <inertia
        ixx="0.00011006"
        ixy="-0.00000058"
        ixz="-0.00000146"
        iyy="0.00010759"
        iyz="-0.00000031"
