    <origin
      xyz="0 0 0.13925"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="Link_1" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3"
      upper="3"
      effort="100"
      velocity="3" />
  </joint>
  <link
    name="Link_2">
    <inertial>
      <origin
        xyz="-0.14996193 -0.00001341 0.01935471"
        rpy="0 0 0" />
      <mass
        value="1.01571325" />
      <inertia
        ixx="0.00145046"
        ixy="-0.00000793"
