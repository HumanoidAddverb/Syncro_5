      <origin
        xyz="-0.0345 0 0.0955"
        rpy="1.5708 0 3.1416" />
      <parent
        link="gripper_base_link" />
      <child
        link="left_link_1" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-1.1"
        upper="0.28"
        effort="10"
        velocity="3" />
    </joint>
    <link
      name="left_link_2">
      <inertial>
        <origin
          xyz="0.0154357672372158 0.0187867677324339 -9.13069674126631E-10"
          rpy="0 0 0" />
        <mass
