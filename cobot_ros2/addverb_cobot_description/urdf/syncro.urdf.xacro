          </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://addverb_cobot_description/syncro_meshes/gripper/left_link_2.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="left_link_2_joint"
      type="revolute">
      <origin
        xyz="0.0084532 0.054765 0"
        rpy="0 0 1.4176" />
      <parent
        link="left_link_1" />
      <child
        link="left_link_2" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-1.57"
        upper="1.57"
        effort="10"
        velocity="3" />
      <mimic joint="gripper_finger_joint" multiplier="-1.0" offset="0"/>
    </joint>
    <link
      name="left_link_3">
      <inertial>
        <origin
          xyz="-0.00334418622613321 0.0283624333398809 -3.10668878198915E-11"
          rpy="0 0 0" />
        <mass
          value="0.0341555144685402" />
        <inertia
