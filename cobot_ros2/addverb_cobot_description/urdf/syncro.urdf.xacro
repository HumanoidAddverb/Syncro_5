      <inertial>
        <origin
          xyz="-0.0155328722189132 0.0204027470076895 6.9960156160884E-06"
          rpy="0 0 0" />
        <mass
          value="0.0512537568596193" />
        <inertia
          ixx="1.29730117956485E-05"
          ixy="-2.28895823639774E-07"
          ixz="-1.62906961760551E-10"
          iyy="8.11595639765549E-06"
          iyz="1.60558480158165E-09"
          izz="1.40525550125839E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://addverb_cobot_description/syncro_meshes/gripper/right_link_1.STL" />
