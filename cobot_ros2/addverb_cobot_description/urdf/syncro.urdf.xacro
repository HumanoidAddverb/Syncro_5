  <link
    name="Link_4">
    <inertial>
      <origin
        xyz="0.05067666 -0.00004877 0.11020526"
        rpy="0 0 0" />
      <mass
        value="1.88943378" />
      <inertia
        ixx="0.00362118"
        ixy="0.00000167"
        ixz="-0.00060345"
        iyy="0.00412573"
        iyz="0.00000579"
        izz="0.00232461" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://addverb_cobot_description/syncro_meshes/Link_4.STL" />
